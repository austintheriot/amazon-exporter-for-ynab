{
  "name": "amazon-exporter-for-ynab",
  "version": "0.1.1",
  "description": "Chrome extension that matches Amazon order history to YNAB transactions: item-name memos, refund attribution, and per-item splits.",
  "private": true,
  "license": "MIT",
  "author": "Joe Paravisini",
  "repository": {
    "type": "git",
    "url": "https://github.com/jparavisini/amazon-exporter-for-ynab.git"
  },
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "zip:store": "STORE_BUILD=1 wxt zip",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "cheerio": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.6.0",
    "vitest": "4.1.11",
    "wxt": "^0.21.4"
  },
  "packageManager": "bun@1.4.2"
}
