{
  "name": "amazon-exporter-for-ynab",
  "version": "0.2.0",
  "description": "Chrome extension that matches Amazon order history to YNAB transactions: item-name memos, refund attribution, and per-item splits.",
  "private": true,
  "license": "MIT",
  "author": "Joe Paravisini",
  "repository": {
    "type": "git",
    "url": "https://github.com/jparavisini/amazon-exporter-for-ynab.git"
  },
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "verify": "bun run typecheck && bun run lint && bun run test",
    "build": "bun run verify && wxt build",
    "zip": "bun run verify && wxt zip",
    "zip:store": "bun run verify && STORE_BUILD=1 wxt zip",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "lit": "3.3.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fast-check/vitest": "0.5.0",
    "@types/node": "^22.20.5",
    "@vitest/eslint-plugin": "1.6.27",
    "eslint": "10.12.0",
    "fast-check": "4.10.2",
    "happy-dom": "20.14.6",
    "jiti": "2.7.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "4.1.11",
    "wxt": "^0.21.4"
  },
  "packageManager": "bun@1.4.2",
  "overrides": {
    "@typescript-eslint/eslint-plugin": {
      ".": "8.71.2",
      "ignore": "7.0.12"
    },
    "@typescript-eslint/parser": "8.71.2",
    "@typescript-eslint/project-service": "8.71.2",
    "@typescript-eslint/scope-manager": "8.71.2",
    "@typescript-eslint/tsconfig-utils": "8.71.2",
    "@typescript-eslint/type-utils": "8.71.2",
    "@typescript-eslint/types": "8.71.2",
    "@typescript-eslint/typescript-estree": "8.71.2",
    "@typescript-eslint/utils": "8.71.2",
    "@typescript-eslint/visitor-keys": "8.71.2"
  }
}
